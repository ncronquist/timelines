# Database (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://timelines:timelines_dev@localhost:5432/timelines"

# API Server
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="info"

# Better Auth
BETTER_AUTH_SECRET="replace-with-at-least-32-char-random-secret-in-dev"
BETTER_AUTH_URL="http://localhost:3001"

# Web Frontend (Vite)
VITE_API_URL="http://localhost:3001"
