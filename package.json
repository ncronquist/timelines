{
  "name": "timelines",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-scale interactive timelines monorepo",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && turbo run typecheck",
    "db:generate": "bun --filter @timelines/api db:generate",
    "db:migrate": "bun --filter @timelines/api db:migrate",
    "db:studio": "bun --filter @timelines/api db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.4.4"
}
